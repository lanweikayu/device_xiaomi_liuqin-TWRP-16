# Keep AOSP seclabel so the process is hal_bootctl_server and can add
# android.hardware.boot.IBootControl (neverallow: only that domain may add).
# GPT/UFS access is granted by device sepolicy + label_bootctrl.sh.
service vendor.boot-default /system/bin/hw/android.hardware.boot-service.default_recovery
    class hal
    user root
    group root
    disabled
    seclabel u:r:hal_bootctl_default:s0
    interface aidl android.hardware.boot.IBootControl/default
